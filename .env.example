# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are public and inlined at build time. Server secrets
# go only in .env.local or the Worker's secret store
# (wrangler secret put NAME), never in this file or in wrangler.jsonc.
#
# The app builds and runs with this file copied as is.

# The app's own address: http://localhost:3000 locally,
# https://app-dev.levuche.com for dev, https://app.levuche.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buildbase sign-in, products and selling arrive with the sign-in work. Their
# names will match the website's .env.example (NEXT_PUBLIC_BUILDBASE_ORG_ID,
# NEXT_PUBLIC_BUILDBASE_ENVIRONMENT, NEXT_PUBLIC_BUILDBASE_CLIENT_ID,
# NEXT_PUBLIC_BUILDBASE_REDIRECT_URL and the server secret
# BUILDBASE_CLIENT_SECRET).
