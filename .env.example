# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_* values are public and inlined at build time. Server secrets
# go only in .env.local or the Worker's secret store
# (wrangler secret put NAME), never in this file or in wrangler.jsonc.
#
# The app builds and runs with this file copied as is.

# The app's own address: http://localhost:3000 locally,
# https://app-dev.levuche.com for dev, https://app.levuche.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Buildbase sign-in (docs/AUTH.md). Leave these empty and the app shows
# "Sign-in isn't open on this address yet" in place of every page.
# The org id and environment key come from the Buildbase console (dev uses
# the development environment's key; production leaves it empty). The client
# is the app's own sign-in client, whose redirect URL list must hold
# NEXT_PUBLIC_BUILDBASE_REDIRECT_URL.
NEXT_PUBLIC_BUILDBASE_ORG_ID=
NEXT_PUBLIC_BUILDBASE_ENVIRONMENT=
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=http://localhost:3000
# Server secret: the client's secret, from the console. Locally only in
# .env.local; on the Workers: npx wrangler secret put BUILDBASE_CLIENT_SECRET
BUILDBASE_CLIENT_SECRET=
