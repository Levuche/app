{
  "name": "levuche-app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:dev": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "e2e:build": "set -a && . ./e2e/e2e.env && set +a && next build",
    "e2e": "playwright test",
    "test": "node --test \"src/**/*.test.ts\" \"sites/**/*.test.ts\"",
    "sites:css": "node sites/build-css.mjs",
    "sites:dev": "npm run sites:css && cd sites && wrangler dev --env dev",
    "sites:build": "npm run sites:css && cd sites && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "sites:deploy": "npm run sites:css && cd sites && wrangler deploy",
    "sites:deploy:dev": "npm run sites:css && cd sites && wrangler deploy --env dev",
    "sites:speed": "node sites/speed.mjs"
  },
  "dependencies": {
    "@buildbase/sdk": "^1.9.0",
    "@levuche/kit": "github:Levuche/kit#v0.2.0",
    "@levuche/ui": "github:Levuche/ui#v0.4.0",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@opennextjs/cloudflare": "^1.20.18",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  }
}
